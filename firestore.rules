rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isMemberOfFamily(familyId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/familyBudgets/$(familyId)).data.memberUids;
    }

    function isValidFamilyBudget(data) {
      return data.id is string &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.familyCode is string && data.familyCode.size() >= 4 && data.familyCode.size() <= 20 &&
             data.passcode is string && data.passcode.size() >= 4 && data.passcode.size() <= 32 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 10 &&
             data.spouse1Name is string && data.spouse1Name.size() <= 50 &&
             data.spouse2Name is string && data.spouse2Name.size() <= 50;
    }

    function isValidTransaction(data) {
      return data.id is string &&
             data.familyId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
             data.amount is number && data.amount >= 0 &&
             data.type in ['EXPENSE', 'INCOME'] &&
             data.category is string &&
             data.spender is string &&
             data.timestamp is number;
    }

    function isValidBudgetLimit(data) {
      return data.categoryName is string &&
             data.monthlyLimit is number && data.monthlyLimit >= 0;
    }

    function isValidSavingsGoal(data) {
      return data.id is string &&
             data.title is string && data.title.size() > 0 &&
             data.targetAmount is number && data.targetAmount >= 0 &&
             data.currentAmount is number && data.currentAmount >= 0;
    }

    function isValidRecurringBill(data) {
      return data.id is string &&
             data.title is string && data.title.size() > 0 &&
             data.amount is number && data.amount >= 0 &&
             data.dueDay is number && data.dueDay >= 1 && data.dueDay <= 31 &&
             data.isPaid is bool &&
             data.spender is string;
    }

    // Family Budgets root collection
    match /familyBudgets/{familyId} {
      // Any authenticated user can query/search by familyCode to join, or read their own family budget
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid in resource.data.memberUids ||
        // Allow reading to verify passcode during join
        request.query.limit <= 5
      );

      // Create new family budget space
      allow create: if isAuthenticated() &&
                    request.auth.uid in request.resource.data.memberUids &&
                    isValidFamilyBudget(request.resource.data);

      // Existing member can update, or a spouse can join if they add themselves to memberUids
      allow update: if isAuthenticated() && (
        (request.auth.uid in resource.data.memberUids && isValidFamilyBudget(request.resource.data)) ||
        // Joining existing family: adding caller uid into memberUids with correct passcode verification
        (request.auth.uid in request.resource.data.memberUids &&
         request.resource.data.passcode == resource.data.passcode &&
         request.resource.data.familyCode == resource.data.familyCode &&
         isValidFamilyBudget(request.resource.data))
      );

      allow delete: if isAuthenticated() && request.auth.uid in resource.data.memberUids;

      // Subcollection: Transactions
      match /transactions/{transactionId} {
        allow read: if isMemberOfFamily(familyId);
        allow create, update: if isMemberOfFamily(familyId) && isValidTransaction(request.resource.data);
        allow delete: if isMemberOfFamily(familyId);
      }

      // Subcollection: Budget Limits
      match /budgetLimits/{limitId} {
        allow read: if isMemberOfFamily(familyId);
        allow create, update: if isMemberOfFamily(familyId) && isValidBudgetLimit(request.resource.data);
        allow delete: if isMemberOfFamily(familyId);
      }

      // Subcollection: Savings Goals
      match /savingsGoals/{goalId} {
        allow read: if isMemberOfFamily(familyId);
        allow create, update: if isMemberOfFamily(familyId) && isValidSavingsGoal(request.resource.data);
        allow delete: if isMemberOfFamily(familyId);
      }

      // Subcollection: Recurring Bills
      match /recurringBills/{billId} {
        allow read: if isMemberOfFamily(familyId);
        allow create, update: if isMemberOfFamily(familyId) && isValidRecurringBill(request.resource.data);
        allow delete: if isMemberOfFamily(familyId);
      }
    }
  }
}
